---
import { getCollection, render } from 'astro:content';
import { getSiteConfig } from '../data/site';

const { lang } = Astro.props;
const site = getSiteConfig(lang);

const allProjects = await getCollection(lang === 'es' ? 'projectsEs' : 'projectsEn');
const featured = allProjects
  .filter(p => p.data.featured)
  .sort((a, b) => b.data.year - a.data.year);

const projectsWithContent = await Promise.all(
  featured.map(async (p) => {
    const { Content } = await render(p);
    return { p, Content };
  })
);

const t = {
  es: { title: "Proyectos Destacados", subtitle: "Proyectos que reflejan mi experiencia y pasión por la tecnología.", viewDetails: "Ver Detalles", close: "Cerrar" },
  en: { title: "Featured Projects", subtitle: "Projects that showcase my experience and passion for technology.", viewDetails: "View Details", close: "Close" },
};
const content = lang === 'es' ? t.es : t.en;
---

<section id="projects" class="py-20 bg-gray-50 dark:bg-slate-900 transition-colors duration-300">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center mb-16">
      <h2 class="text-3xl md:text-4xl font-bold text-slate-900 dark:text-white mb-4">{content.title}</h2>
      <p class="text-lg text-slate-600 dark:text-slate-300 max-w-2xl mx-auto">{content.subtitle}</p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
      {projectsWithContent.map(({ p }) => (
        <div class="project-card bg-white dark:bg-slate-800 rounded-2xl overflow-hidden shadow-lg border border-gray-100 dark:border-slate-700 hover:shadow-xl transition-all group">
          <div class="relative overflow-hidden">
            <img src={p.data.image} alt={p.data.title} class="w-full h-48 object-cover group-hover:scale-105 transition-transform duration-500" />
            <div class="absolute top-3 right-3 flex gap-2">
              {p.data.githubUrl && (
                <a href={p.data.githubUrl} target="_blank" class="p-2 bg-white/90 dark:bg-slate-900/90 rounded-lg shadow hover:bg-white dark:hover:bg-slate-900 transition-colors" aria-label="GitHub">
                  <svg class="w-5 h-5 text-slate-700 dark:text-slate-300" fill="currentColor" viewBox="0 0 24 24"><path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/></svg>
                </a>
              )}
              {p.data.liveUrl && (
                <a href={p.data.liveUrl} target="_blank" class="p-2 bg-white/90 dark:bg-slate-900/90 rounded-lg shadow hover:bg-white dark:hover:bg-slate-900 transition-colors" aria-label="Live Demo">
                  <svg class="w-5 h-5 text-slate-700 dark:text-slate-300" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/></svg>
                </a>
              )}
            </div>
          </div>
          <div class="p-6">
            <div class="flex flex-wrap gap-2 mb-3">
              {p.data.tags.map(tag => (
                <span class="px-2.5 py-0.5 text-xs font-medium bg-blue-100 dark:bg-blue-900/30 text-blue-800 dark:text-blue-200 rounded-full">{tag}</span>
              ))}
            </div>
            <h3 class="text-xl font-bold text-slate-900 dark:text-white mb-2">{p.data.title}</h3>
            <p class="text-slate-600 dark:text-slate-400 text-sm mb-4 line-clamp-2">{p.data.description}</p>
            <button class="project-detail-btn text-blue-600 dark:text-blue-400 hover:text-blue-700 dark:hover:text-blue-300 font-semibold text-sm transition-colors" data-project-id={p.id}>
              {content.viewDetails} →
            </button>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<!-- Modales pre-renderizados en HTML puro con Astro -->
{projectsWithContent.map(({ p, Content }) => (
  <div id={`modal-${p.id}`} class="project-modal-container fixed inset-0 z-50 hidden items-center justify-center p-4 bg-black/60 backdrop-blur-md">
    <div class="bg-white dark:bg-slate-800 rounded-2xl max-w-2xl w-full max-h-[90vh] overflow-y-auto shadow-2xl border border-gray-100 dark:border-slate-700">
      <div class="relative">
        <img src={p.data.image} alt={p.data.title} class="w-full h-64 object-cover rounded-t-2xl" />
        <button class="modal-close-btn absolute top-4 right-4 p-2 bg-white/90 dark:bg-slate-900/90 rounded-full shadow hover:bg-white dark:hover:bg-slate-900 transition-colors" data-project-id={p.id}>
          <svg class="w-6 h-6 text-slate-700 dark:text-slate-300" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
        </button>
      </div>
      <div class="p-8">
        <div class="flex flex-wrap gap-2 mb-4">
          {p.data.tags.map(t => (
            <span class="px-2.5 py-0.5 text-xs font-medium bg-blue-100 dark:bg-blue-900/30 text-blue-800 dark:text-blue-200 rounded-full">{t}</span>
          ))}
        </div>
        <h3 class="text-2xl font-bold text-slate-900 dark:text-white mb-6">{p.data.title}</h3>
        
        <!-- Renderizado de HTML puro MDX -->
        <div class="text-slate-600 dark:text-slate-300 leading-relaxed mb-8 space-y-4 text-base">
          <Content />
        </div>

        <div class="flex flex-wrap gap-4 pt-4 border-t border-gray-100 dark:border-slate-700">
          {p.data.githubUrl && (
            <a href={p.data.githubUrl} target="_blank" class="px-6 py-3 rounded-xl bg-slate-900 dark:bg-slate-700 text-white hover:bg-slate-800 dark:hover:bg-slate-600 transition-colors font-medium text-sm inline-flex items-center gap-2 shadow-md">
              <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24"><path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/></svg>
              GitHub
            </a>
          )}
          {p.data.liveUrl && (
            <a href={p.data.liveUrl} target="_blank" class="px-6 py-3 rounded-xl bg-blue-600 text-white hover:bg-blue-700 transition-colors font-medium text-sm inline-flex items-center gap-2 shadow-md">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/></svg>
              Live Demo
            </a>
          )}
        </div>
      </div>
    </div>
  </div>
))}

<script>
  let activeModal: HTMLElement | null = null;

  const openModal = (id: string) => {
    const modal = document.getElementById(`modal-${id}`);
    if (!modal) return;

    modal.classList.remove('hidden');
    modal.classList.add('flex');
    document.body.style.overflow = 'hidden';
    activeModal = modal;
  };

  const closeModal = () => {
    if (!activeModal) return;
    activeModal.classList.add('hidden');
    activeModal.classList.remove('flex');
    document.body.style.overflow = '';
    activeModal = null;
  };

  document.querySelectorAll<HTMLElement>('.project-detail-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      const id = btn.dataset.projectId;
      if (id) openModal(id);
    });
  });

  document.querySelectorAll('.modal-close-btn').forEach(btn => {
    btn.addEventListener('click', closeModal);
  });

  document.querySelectorAll<HTMLElement>('.project-modal-container').forEach(modal => {
    modal.addEventListener('click', (e) => {
      if (e.target === modal) closeModal();
    });
  });

  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') closeModal();
  });
</script>