---
// Obtenemos la URL actual en la que está el usuario
const currentPath = Astro.url.pathname;

// Detectamos el idioma actual
const currentLang = currentPath.startsWith('/en') ? 'en' : 'es';

// Construimos las URLs para ambos botones
const urlEs = currentLang === 'es' ? currentPath : currentPath.replace('/en', '/es');
const urlEn = currentLang === 'en' ? currentPath : currentPath.replace('/es', '/en');

// Clases CSS compartidas para los botones (activos vs inactivos)
const baseClasses = "p-1.5 rounded-md transition-all duration-200 flex items-center justify-center";
const activeClasses = "bg-white dark:bg-slate-600 shadow-sm opacity-100 ring-1 ring-gray-200 dark:ring-gray-500 scale-105";
const inactiveClasses = "opacity-50 hover:opacity-100 hover:bg-gray-200 dark:hover:bg-slate-700 grayscale-[50%] hover:grayscale-0";
---

<div class="inline-flex items-center p-1 bg-gray-100 dark:bg-slate-800 rounded-lg border border-gray-200 dark:border-slate-700 shadow-inner">
  <!-- Botón Español -->
  <a 
    href={urlEs}
    class={`${baseClasses} ${currentLang === 'es' ? activeClasses : inactiveClasses}`}
    aria-label="Español"
    title="Español"
  >
    <img src="https://flagcdn.com/es.svg" width="20" alt="Español" class="rounded-sm shadow-sm" />
  </a>

  <!-- Separador sutil -->
  <div class="w-px h-4 bg-gray-300 dark:bg-slate-600 mx-1"></div>

  <!-- Botón Inglés -->
  <a 
    href={urlEn}
    class={`${baseClasses} ${currentLang === 'en' ? activeClasses : inactiveClasses}`}
    aria-label="English"
    title="English"
  >
    <img src="https://flagcdn.com/us.svg" width="20" alt="English" class="rounded-sm shadow-sm" />
  </a>
</div>